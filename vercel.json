{
  "framework": "nextjs",
  "buildCommand": "npm --prefix finiq-web ci && npm --prefix finiq-web run build",
  "outputDirectory": "finiq-web/.next",
  "installCommand": "npm --prefix finiq-web install",
  "functions": {
    "finiq-web/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
